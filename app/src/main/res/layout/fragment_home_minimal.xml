<?xml version="1.0" encoding="utf-8"?>
<!--
    Redesign 3.2: Home variant "Minimal".
    Hero card IS the connect action (tap anywhere on it), plus a 2x2 grid of
    large tiles. Contains the same tile / exit IDs as the other variants so
    HomeFragment's shared binding works unchanged.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_buttons_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintWidth_max="560dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <!-- Hero: the card itself is the Connect button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_hero_card"
            style="@style/Widget.HUR.Card.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/dsSurfaceElevated"
            app:strokeColor="?attr/dsPrimary"
            app:contentPadding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/home_hero_icon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_launch_white"
                    app:tint="?attr/dsPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_hero_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/home_ready"
                        android:textAppearance="@style/TextAppearance.HUR.Title" />

                    <TextView
                        android:id="@+id/home_hero_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_tap_to_connect"
                        android:textAppearance="@style/TextAppearance.HUR.Body"
                        android:textColor="?attr/dsText2" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Row 1: Self Mode + USB -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/self_mode_button"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/tile_gradient_self"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_launch_white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="64dp"
                    app:iconTint="#ffffff" />

                <TextView
                    android:id="@+id/self_mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/self_mode"
                    android:textColor="@color/text_primary"
                    android:textFontWeight="700"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/usb_button"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tile_gradient_usb"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_usb_white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="64dp"
                    app:iconTint="#ffffff" />

                <TextView
                    android:id="@+id/usb_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/usb"
                    android:textColor="@color/text_primary"
                    android:textFontWeight="700"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: WiFi + Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wifi_button"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/tile_gradient_wifi"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_network_wifi_white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="64dp"
                    app:iconTint="#ffffff" />

                <TextView
                    android:id="@+id/wifi_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/wifi"
                    android:textColor="@color/text_primary"
                    android:textFontWeight="700"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_button"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tile_gradient_settings"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_settings_white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="64dp"
                    app:iconTint="#ffffff" />

                <TextView
                    android:id="@+id/settings_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings"
                    android:textColor="@color/text_primary"
                    android:textFontWeight="700"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/exit"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/material_grey_700"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
