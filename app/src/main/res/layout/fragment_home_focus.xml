<?xml version="1.0" encoding="utf-8"?>
<!--
    Redesign 3.2: Home variant "Focus" (min2).
    One large daily connect button (last-used mode) as the hero, plus a compact
    row of the 4 tiles for the other actions. Same tile / exit IDs as the other
    variants so HomeFragment's shared binding works unchanged.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_buttons_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintWidth_max="560dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <TextView
            android:id="@+id/home_daily_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_ready"
            android:textAppearance="@style/TextAppearance.HUR.Overline" />

        <!-- Big daily connect button (primary action) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_daily_button"
            style="@style/Widget.HUR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            app:icon="@drawable/ic_launch_white"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            android:text="@string/home_connect" />

        <!-- Compact secondary row: the 4 tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/self_mode_button"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tile_gradient_self"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_launch_white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="34dp"
                    app:iconTint="#ffffff" />

                <TextView
                    android:id="@+id/self_mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/self_mode"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/usb_button"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/tile_gradient_usb"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_usb_white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="34dp"
                    app:iconTint="#ffffff" />

                <TextView
                    android:id="@+id/usb_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/usb"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wifi_button"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/tile_gradient_wifi"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_network_wifi_white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="34dp"
                    app:iconTint="#ffffff" />

                <TextView
                    android:id="@+id/wifi_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/wifi"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_button"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/tile_gradient_settings"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_settings_white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="34dp"
                    app:iconTint="#ffffff" />

                <TextView
                    android:id="@+id/settings_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/exit"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/material_grey_700"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
