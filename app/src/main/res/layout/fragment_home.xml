<?xml version="1.0" encoding="utf-8"?>
<!--
    Redesign 3.2: landscape home.
    Two-column layout: "Available devices" status card on the left,
    2×2 tile grid (Self Mode / USB / WiFi / Settings) on the right.
    All view IDs are preserved from the previous layout so HomeFragment
    logic (listeners, monochrome styling, auto-connect) keeps working.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Left column: status card -->
    <include
        android:id="@+id/home_status_card"
        layout="@layout/view_home_status_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintWidth_percent="0.36"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- Right column: 2×2 tile grid -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_buttons_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toEndOf="@+id/home_status_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Row 1: Self Mode + USB -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/self_mode_button"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_margin="12dp"
            android:background="@drawable/tile_gradient_self"
            android:elevation="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_launch_white"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="60dp"
            app:iconTint="#ffffff"
            app:layout_constraintEnd_toStartOf="@+id/usb_button"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/usb_button"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_margin="12dp"
            android:background="@drawable/tile_gradient_usb"
            android:elevation="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_usb_white"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="60dp"
            app:iconTint="#ffffff"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/self_mode_button"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/self_mode_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:shadowColor="@color/text_shadow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:text="@string/self_mode"
            android:textColor="@color/text_primary"
            android:textFontWeight="700"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/self_mode_button"
            app:layout_constraintStart_toStartOf="@+id/self_mode_button"
            app:layout_constraintTop_toBottomOf="@+id/self_mode_button" />

        <TextView
            android:id="@+id/usb_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:shadowColor="@color/text_shadow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:text="@string/usb"
            android:textColor="@color/text_primary"
            android:textFontWeight="700"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/usb_button"
            app:layout_constraintStart_toStartOf="@+id/usb_button"
            app:layout_constraintTop_toBottomOf="@+id/usb_button" />

        <!-- Row 2: WiFi + Settings -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/wifi_button"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_margin="12dp"
            android:background="@drawable/tile_gradient_wifi"
            android:elevation="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_network_wifi_white"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="60dp"
            app:iconTint="#ffffff"
            app:layout_constraintEnd_toStartOf="@+id/settings_button"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/self_mode_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_button"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_margin="12dp"
            android:background="@drawable/tile_gradient_settings"
            android:elevation="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_settings_white"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="60dp"
            app:iconTint="#ffffff"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/wifi_button"
            app:layout_constraintTop_toBottomOf="@+id/usb_text" />

        <TextView
            android:id="@+id/wifi_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:shadowColor="@color/text_shadow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:text="@string/wifi"
            android:textColor="@color/text_primary"
            android:textFontWeight="700"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/wifi_button"
            app:layout_constraintStart_toStartOf="@+id/wifi_button"
            app:layout_constraintTop_toBottomOf="@+id/wifi_button" />

        <TextView
            android:id="@+id/settings_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:shadowColor="@color/text_shadow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textFontWeight="700"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/settings_button"
            app:layout_constraintStart_toStartOf="@+id/settings_button"
            app:layout_constraintTop_toBottomOf="@+id/settings_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/exit"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/material_grey_700"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
