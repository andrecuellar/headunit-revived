<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/onb_welcome_title"
            android:textAppearance="@style/TextAppearance.HUR.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/onb_welcome_body"
            android:textAppearance="@style/TextAppearance.HUR.Body"
            android:textColor="?attr/dsText2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/onb_welcome_lang"
            android:textAppearance="@style/TextAppearance.HUR.Overline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onb_language_button"
            style="@style/Widget.HUR.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:icon="@drawable/ic_arrow_down"
            app:iconGravity="textEnd"
            app:iconTint="?attr/dsText3" />
    </LinearLayout>
</ScrollView>
