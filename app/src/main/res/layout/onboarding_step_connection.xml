<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onb_conn_title"
            android:textAppearance="@style/TextAppearance.HUR.Heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onb_conn_body"
            android:textAppearance="@style/TextAppearance.HUR.Body"
            android:textColor="?attr/dsText2" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/onb_conn_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_conn_usb"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:minHeight="56dp"
                android:text="@string/onb_conn_usb"
                app:icon="@drawable/ic_usb_white"
                app:iconGravity="textStart"
                app:iconTint="?attr/dsUsb" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_conn_wifi"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:minHeight="56dp"
                android:text="@string/onb_conn_wifi"
                app:icon="@drawable/ic_network_wifi_white"
                app:iconGravity="textStart"
                app:iconTint="?attr/dsPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_conn_self"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:minHeight="56dp"
                android:text="@string/onb_conn_self"
                app:icon="@drawable/ic_launch_white"
                app:iconGravity="textStart"
                app:iconTint="?attr/dsText2" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</ScrollView>
