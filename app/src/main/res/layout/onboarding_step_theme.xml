<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onb_theme_title"
            android:textAppearance="@style/TextAppearance.HUR.Heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/onb_theme_body"
            android:textAppearance="@style/TextAppearance.HUR.Body"
            android:textColor="?attr/dsText2" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/onb_theme_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_theme_light"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onb_theme_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_theme_dark"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onb_theme_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_theme_extreme"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onb_theme_extreme" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Live preview: a mini card that shows the tokens of the chosen theme -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HUR.Card.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.HUR.Subtitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_available_devices"
                    android:textAppearance="@style/TextAppearance.HUR.Caption" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/tile_gradient_self" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.HUR.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="false"
                    android:text="@string/home_connect" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Redesign 3.2: Home layout variant selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/home_layout_title"
            android:textAppearance="@style/TextAppearance.HUR.Overline" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/onb_home_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_home_minimal"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_layout_minimal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_home_focus"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_layout_focus" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_home_full"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_layout_full" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</ScrollView>
