<?xml version="1.0" encoding="utf-8"?>
<!--
    Redesign 3.2: Home "Available devices" status card.
    Included by fragment_home.xml (landscape, left column) and
    layout-port/fragment_home.xml (portrait, above the tile grid).

    Populated by HomeFragment.updateStatusCard():
    - Primary entry = attached USB device, else last session (WiFi IP /
      USB device / Nearby), else Self Mode fallback when the last session
      was the loopback server (design rule), else empty state.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_status_card"
    style="@style/Widget.HUR.Card.Large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:contentPadding="@dimen/ds_space_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_status_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_available_devices"
            android:textAppearance="@style/TextAppearance.HUR.Overline" />

        <!-- Highlighted primary device sub-card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_device_card"
            style="@style/Widget.HUR.Card.Item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_m"
            app:cardBackgroundColor="?attr/dsSurfaceElevated"
            app:strokeColor="?attr/dsPrimary"
            app:contentPadding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/home_device_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_usb_white"
                    app:tint="?attr/dsText2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_device_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.HUR.Subtitle" />

                    <TextView
                        android:id="@+id/home_device_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.HUR.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Empty state (shown when there is nothing to connect to) -->
        <TextView
            android:id="@+id/home_status_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_m"
            android:text="@string/home_no_devices"
            android:textAppearance="@style/TextAppearance.HUR.Caption"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_connect_button"
            style="@style/Widget.HUR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/home_connect" />

        <TextView
            android:id="@+id/home_status_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/home_auto_connect_note"
            android:textAppearance="@style/TextAppearance.HUR.Caption"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
