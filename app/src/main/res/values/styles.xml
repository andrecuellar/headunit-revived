<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="colorPrimary">@color/brand_teal</item>
        <item name="colorSecondary">@color/brand_teal</item>
        <item name="colorAccent">@color/brand_teal</item>
        <item name="android:colorAccent">@color/brand_teal</item>
        <item name="android:dialogTheme">@style/DarkAlertDialog</item>
        <item name="android:alertDialogTheme">@style/DarkAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/DarkAlertDialog</item>
        <!-- Redesign 3.2: map Material color roles to the ds palette so every
             Material-role-based screen (dialogs, quick settings, sheets,
             projection chrome) matches the design across all three themes. -->
        <item name="colorSurface">@color/ds_surface_light</item>
        <item name="colorOnSurface">@color/ds_text_light</item>
        <item name="android:colorBackground">@color/ds_bg_light</item>
        <!-- Design system tokens (redesign 3.2). ds_*_light resolves to the
             DARK values under values-night/ automatically in night mode. -->
        <item name="dsBg">@color/ds_bg_light</item>
        <item name="dsSurface">@color/ds_surface_light</item>
        <item name="dsSurfaceElevated">@color/ds_surface_elevated_light</item>
        <item name="dsLine">@color/ds_line_light</item>
        <item name="dsText">@color/ds_text_light</item>
        <item name="dsText2">@color/ds_text2_light</item>
        <item name="dsText3">@color/ds_text3_light</item>
        <item name="dsPrimary">@color/ds_primary_light</item>
        <item name="dsOnPrimary">@color/ds_on_primary_light</item>
        <item name="dsDanger">@color/ds_danger_light</item>
        <item name="dsSuccess">@color/ds_success_light</item>
        <item name="dsWarning">@color/ds_warning_light</item>
        <item name="dsScrim">@color/ds_scrim_light</item>
        <item name="dsUsb">@color/ds_usb_light</item>
    </style>

    <style name="AppTheme.Translucent" parent="android:Theme.Translucent.NoTitleBar" />

    <style name="AppTheme.Fullscreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/color_projection_blue</item>
        <item name="android:navigationBarColor">@color/color_projection_blue</item>
    </style>

    <style name="SplashTheme.Fullscreen" parent="SplashTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="DarkAlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/brand_teal</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand_teal</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:colorAccent">@color/brand_teal</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:textColorPrimary">@color/adaptive_text_color</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton.Negative</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.App.Dialog.Rounded</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Dialog.Rounded</item>
    </style>

    <style name="DialogButton.Positive" parent="Widget.Material3.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/brand_teal</item>
        <item name="android:backgroundTint">@color/brand_teal</item>
        <item name="android:background">@drawable/btn_primary_teal</item>
    </style>

    <style name="DialogButton.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/brand_teal</item>
        <item name="colorSecondary">@color/brand_teal</item>
    </style>
    <style name="DialogWindowTitle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="SafetyDialogTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ThemeOverlay.ExtremeDark" parent="">
        <item name="colorSurface">@color/extreme_dark_background</item>
        <item name="colorOnSurface">@color/ds_text_extreme</item>
        <item name="android:colorBackground">@color/extreme_dark_background</item>
        <item name="android:windowBackground">@color/extreme_dark_background</item>
        <!-- Reassign ALL design system tokens to the Extreme (pure black) set. -->
        <item name="dsBg">@color/ds_bg_extreme</item>
        <item name="dsSurface">@color/ds_surface_extreme</item>
        <item name="dsSurfaceElevated">@color/ds_surface_elevated_extreme</item>
        <item name="dsLine">@color/ds_line_extreme</item>
        <item name="dsText">@color/ds_text_extreme</item>
        <item name="dsText2">@color/ds_text2_extreme</item>
        <item name="dsText3">@color/ds_text3_extreme</item>
        <item name="dsPrimary">@color/ds_primary_extreme</item>
        <item name="dsOnPrimary">@color/ds_on_primary_extreme</item>
        <item name="dsDanger">@color/ds_danger_extreme</item>
        <item name="dsSuccess">@color/ds_success_extreme</item>
        <item name="dsWarning">@color/ds_warning_extreme</item>
        <item name="dsScrim">@color/ds_scrim_extreme</item>
        <item name="dsUsb">@color/ds_usb_extreme</item>
    </style>

    <style name="ThemeOverlay.GradientBackground" parent="">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
    </style>

    <!-- Segmented Button Shapes -->
    <style name="ShapeAppearance.App.Button.Left" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Button.Middle" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Button.Right" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.Dialog.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- ============================================================
         Typography scale (redesign 3.2). Roboto (system default).
         sans-serif-medium (API21+) degrades to normal on older devices.
         ============================================================ -->
    <style name="TextAppearance.HUR.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">?attr/dsText</item>
    </style>
    <style name="TextAppearance.HUR.Heading" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/dsText</item>
    </style>
    <style name="TextAppearance.HUR.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/dsText</item>
    </style>
    <style name="TextAppearance.HUR.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/dsText</item>
    </style>
    <style name="TextAppearance.HUR.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/dsText</item>
    </style>
    <style name="TextAppearance.HUR.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/dsText2</item>
    </style>
    <style name="TextAppearance.HUR.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/dsText3</item>
    </style>
    <style name="TextAppearance.HUR.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.07</item>
        <item name="android:textColor">?attr/dsText3</item>
    </style>

    <!-- ============================================================
         Component styles (redesign 3.2). MaterialCardView / MaterialButton
         resolve ?attr/ds* on all API levels (unlike ?attr in shape XML).
         ============================================================ -->
    <style name="Widget.HUR.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/dsSurface</item>
        <item name="strokeColor">?attr/dsLine</item>
        <item name="strokeWidth">@dimen/ds_stroke</item>
        <item name="cardCornerRadius">@dimen/ds_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">?attr/dsLine</item>
    </style>
    <style name="Widget.HUR.Card.Item">
        <item name="cardCornerRadius">@dimen/ds_radius_item</item>
    </style>
    <style name="Widget.HUR.Card.Large">
        <item name="cardCornerRadius">@dimen/ds_radius_card_lg</item>
    </style>

    <style name="Widget.HUR.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/dsPrimary</item>
        <item name="android:textColor">?attr/dsOnPrimary</item>
        <item name="cornerRadius">@dimen/ds_radius_button</item>
        <item name="android:minHeight">@dimen/ds_button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.HUR.Subtitle</item>
    </style>
    <style name="Widget.HUR.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/dsLine</item>
        <item name="android:textColor">?attr/dsText2</item>
        <item name="cornerRadius">@dimen/ds_radius_button</item>
        <item name="android:minHeight">@dimen/ds_button_height</item>
    </style>
    <style name="Widget.HUR.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/dsDanger</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">@dimen/ds_radius_button</item>
        <item name="android:minHeight">@dimen/ds_button_height</item>
    </style>
</resources>
